# =============================================================================
#  RDS Guard — Configuration
#  Copy this file to .env and edit to match your setup.
# =============================================================================

# --- RTL-SDR ---
FM_FREQUENCY=103.3M            # Your local P4 frequency (see README for list)
# FM_FREQUENCIES=103.3M,102.9M # Multi-station: 2-4 comma-separated frequencies within 2 MHz of each other
RTL_GAIN=8                     # Tuner gain in dB (0-50)
PPM_CORRECTION=0               # Frequency correction for your dongle
RTL_DEVICE_INDEX=0             # Device index if multiple dongles
# RTL_DEVICE_SERIAL=           # Select dongle by serial number instead of index

# --- MQTT (optional) ---
MQTT_ENABLED=false             # Enable MQTT publishing (true/false)
# MQTT_HOST=192.168.1.100      # Broker hostname/IP
# MQTT_PORT=1883               # Broker port
# MQTT_USER=                   # Username (optional)
# MQTT_PASSWORD=               # Password (optional)
MQTT_TOPIC_PREFIX=rds          # Base topic prefix
MQTT_CLIENT_ID=rds-guard       # MQTT client ID
MQTT_QOS=1                     # Default QoS level
MQTT_RETAIN_STATE=true         # Retain state topics

# --- Publishing control ---
PUBLISH_MODE=essential         # "essential" = alerts for traffic & emergencies only. "all" = every decoded RDS field + EON on alert topic.
PUBLISH_RAW=false              # Publish raw RDS groups to system/raw (high volume)
STATUS_INTERVAL=30             # Seconds between MQTT status messages

# --- Web UI ---
WEB_UI_PORT=8022               # HTTP port for the web UI and API
EVENT_RETENTION_DAYS=30        # Auto-delete events older than this (days)
# WEB_UI_URL=https://rds.example.se  # Optional: push messages link to the event
NOTIFY_TIMEZONE=Europe/Stockholm  # Time zone for the days/times in push rules
# Password for the Admin page (push rules under Admin → Aviseringar).
# Empty = the Admin page is switched off and the rules cannot be changed.
ADMIN_PASSWORD=

# --- Audio recording ---
# Audio is always recorded during traffic and emergency events.
AUDIO_DIR=/data/audio          # Directory for recorded audio files
RECORD_EVENT_TYPES=traffic,emergency  # Comma-separated event types to record
AUDIO_FORMAT=ogg               # Output format: "ogg" (Opus) or "wav"
MAX_RECORDING_SEC=600          # Maximum recording duration (safety cutoff)

# --- Transcription ---
# "local"  = built-in faster-whisper on CPU (works out of the box)
# "remote" = external Whisper ASR server via HTTP
# "elevenlabs" = ElevenLabs Scribe cloud API with local fallback (default;
#                without ELEVENLABS_API_KEY it transcribes locally)
# "none"   = disable transcription (audio is still recorded and playable)
TRANSCRIPTION_ENGINE=elevenlabs
TRANSCRIPTION_LANGUAGE=sv      # Language code (sv, en, de, etc.)

# Local engine settings (TRANSCRIPTION_ENGINE=local, and the fallback)
TRANSCRIPTION_MODEL=            # empty = bundled KB-Whisper small (strict) for sv; or tiny…large-v3, KBLab/kb-whisper-medium
#TRANSCRIPTION_PROMPT=Trafikverket, E4, E18, olycka, kö, körfält
TRANSCRIPTION_DEVICE=cpu       # cpu or cuda

# Remote engine settings (only used when TRANSCRIPTION_ENGINE=remote)
# WHISPER_REMOTE_URL=http://whisper:9000
# WHISPER_REMOTE_TIMEOUT=120   # HTTP timeout in seconds

# ElevenLabs Scribe (TRANSCRIPTION_ENGINE=elevenlabs, the default).
# Cloud API, ~USD 0.20-0.24 per hour of audio (2-3 öre per message); on API errors the clip is
# transcribed locally instead (TRANSCRIPTION_FALLBACK=local).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=scribe_v3      # scribe_v3 (numbers as digits) or scribe_v2
# ELEVENLABS_KEYTERMS=E18, Karlstad, Bergviksmotet, Våxnäsmotet, Klaramotet
# ELEVENLABS_TIMEOUT=60
# TRANSCRIPTION_FALLBACK=local    # local or none

# --- Location and map ---
# Where the receiver is, as "Ort, Län". Places the traffic messages on the
# map (Karta) and is reported to the aggregator in satellite mode.
NODE_LOCATION=                    # e.g. Karlstad, Värmlands län
# "claude" = Claude reads the message, corrects misheard words and finds the
#            places (rules as fallback; runs as "rules" without a key)
# "rules"  = local patterns + place-name registry only (free, offline)
# "none"   = no map
GEO_ENGINE=claude
ANTHROPIC_API_KEY=                # Optional, about 1-3 öre per message with Haiku
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_TIMEOUT=60
# Local place names for the transcriber to listen for (ElevenLabs keyterms,
# about 20 % more per clip; and the local Whisper prompt)
# TRANSCRIPTION_PLACE_NAMES=true
# Trafikverket (optional, free key from data.trafikverket.se): exact places
# and updates for accidents, obstacles and restrictions near the receiver.
# Needs NODE_LOCATION. Empty = off.
TRAFIKVERKET_API_KEY=
# TRAFIKVERKET_RADIUS_KM=150
# TRAFIKVERKET_POLL_SEC=60

# --- Uplink to an aggregator (optional, satellite mode) ---
# Leave UPLINK_URL empty to run standalone. When set, events, their audio and
# a status heartbeat are also sent to the aggregator. Transcriptions are not
# sent. Everything keeps working locally either way.
# UPLINK_URL=https://rds.example.com  # Aggregator address (from its owner)
# UPLINK_TOKEN=                       # Node token (from the aggregator's owner)
# NODE_NAME=                          # Your name or place, shown on the aggregator
# UPLINK_HEARTBEAT_SEC=30             # Seconds between status reports
# UPLINK_MAX_AGE_HOURS=72             # Drop unsent items older than this
# Satellite only: process recordings here (transcription + map) and also send
# them, or only record and send them and let the aggregator do everything.
# A standalone installation always processes its own recordings.
# LOCAL_PROCESSING=true               # false = raw recordings to the aggregator only

# --- Satellite + aggregator on one host (docker-compose.yml) ---
# The aggregator reads this same file. The compose file sets the satellite's
# UPLINK_URL to the aggregator once UPLINK_TOKEN is set:
#   docker compose exec aggregator python3 -m aggregator.nodes add "Hemma"
# UPLINK_TOKEN=                        # From the command above (or the import)
# AGGREGATOR_UI_PORT=8080              # The aggregator's web UI (keep it on your LAN)
# AGGREGATOR_UI_BIND=0.0.0.0
# AGGREGATOR_WEB_UI_URL=               # Its address, e.g. https://rds.example.se: push messages link to the event
# AGGREGATOR_RETENTION_DAYS=90         # The aggregator's archive (EVENT_RETENTION_DAYS is the satellite's)
# AGGREGATOR_MQTT_TOPIC_PREFIX=        # Default: MQTT_TOPIC_PREFIX, so Home Assistant keeps its topics
# SATELLITE_MQTT_ENABLED=false         # The satellite's own MQTT (pushes would come twice)
