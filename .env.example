# =============================================================================
#  RDS Guard — Configuration (docker-compose.yml: satellite + aggregator)
#  Copy this file to .env and edit. Both services read it.
#  A satellite on its own (docker-compose.satellite.yml) needs only the
#  satellite part (.env.satellite.example has just that); an aggregator on
#  its own uses aggregator/.env.example.
# =============================================================================

# =============================== Satellite ===================================

# --- Joining the aggregator ---
# The same JOIN_KEY for both approves the satellite at once. Any long random
# text: openssl rand -hex 16. Without it the satellite waits as a pending
# node until it is approved in Admin -> Noder (the code is in its log).
JOIN_KEY=
# Shown on the aggregator, e.g. Hemma
NODE_NAME=
# Where the receiver is, as "Ort, Län": a suggestion, the aggregator's
# Admin -> Noder has the last word. Places the traffic messages on the map.
# e.g. Karlstad, Värmlands län
NODE_LOCATION=
# A satellite on another machine: the aggregator's address (the combined
# compose sets it for you)
# AGGREGATOR_URL=https://rds.example.com
# UPLINK_TOKEN=                # Only if the aggregator's owner gave you one
# UPLINK_HEARTBEAT_SEC=10      # Seconds between status reports
# UPLINK_MAX_AGE_HOURS=168     # Drop unsent items older than this

# --- Radio ---
# Not here: rds-data/receivers.yml. On its first start the satellite writes
# it with the connected dongles commented out: remove the # and set the
# frequencies (see receivers.example.yml).

# --- Recording ---
RECORD_EVENT_TYPES=traffic,emergency  # Event types to record
MAX_RECORDING_SEC=600          # Safety cutoff (at most 1200)
# SATELLITE_KEEP_DAYS=7        # Keep delivered recordings this long

# ============================== Aggregator ===================================

# The web UI: port 8080 on this host (no login for the archive; keep it on
# your LAN). Admin needs this password; empty = Admin is switched off.
ADMIN_PASSWORD=
# AGGREGATOR_UI_PORT=8080
# AGGREGATOR_UI_BIND=0.0.0.0
# AGGREGATOR_WEB_UI_URL=       # e.g. https://rds.example.se: push messages link to the event
# AGGREGATOR_RETENTION_DAYS=90 # Archive: delete events and audio older than this
NOTIFY_TIMEZONE=Europe/Stockholm  # Time zone for the days/times in push rules
# PUBLIC_URL=                  # The HTTPS address satellites elsewhere use (setup lines in Admin)
# TRUSTED_PROXIES=             # Your reverse proxy's address, so joins are limited per real IP

# --- Transcription ---
# "local"  = built-in faster-whisper on CPU (works out of the box)
# "remote" = external Whisper ASR server via HTTP
# "elevenlabs" = ElevenLabs Scribe cloud API with local fallback (default;
#                without ELEVENLABS_API_KEY it transcribes locally)
# "none"   = no transcription (audio is still stored and playable)
TRANSCRIPTION_ENGINE=elevenlabs
TRANSCRIPTION_LANGUAGE=sv
# empty = bundled KB-Whisper small (strict) for sv; or tiny…large-v3, KBLab/kb-whisper-medium
TRANSCRIPTION_MODEL=
#TRANSCRIPTION_PROMPT=Trafikverket, E4, E18, olycka, kö, körfält
TRANSCRIPTION_DEVICE=cpu       # cpu or cuda
# WHISPER_REMOTE_URL=http://whisper:9000
# WHISPER_REMOTE_TIMEOUT=120
# ElevenLabs Scribe: ~USD 0.20-0.24 per hour of audio (2-3 öre per message);
# on API errors the clip is transcribed locally (TRANSCRIPTION_FALLBACK=local).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=scribe_v3
# ELEVENLABS_KEYTERMS=E18, Karlstad, Bergviksmotet, Våxnäsmotet, Klaramotet
# TRANSCRIPTION_FALLBACK=local

# --- Map ---
# "claude" = Claude corrects misheard words and finds the places (rules as
#            fallback; runs as "rules" without a key)
# "rules"  = local patterns + place-name registry only (free, offline)
# "none"   = no map
GEO_ENGINE=claude
# Optional, about 1-3 öre per message with Haiku
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# TRANSCRIPTION_PLACE_NAMES=true
# Trafikverket (optional, free key from data.trafikverket.se): exact places
# and updates for accidents near every node with a location. Empty = off.
TRAFIKVERKET_API_KEY=
# TRAFIKVERKET_RADIUS_KM=150

# --- MQTT (optional; events only, from the aggregator) ---
MQTT_ENABLED=false
# MQTT_HOST=192.168.1.100
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=rds          # Keeps Home Assistant's rds/alert, rds/notify/…
