  "cards": [
    {
      "dot": "emerald",
      "title": "Satellite (standalone without UPLINK_URL)",
      "items": [
        "Keeps its own events, audio, transcriptions and optional MQTT; transcribes with ElevenLabs or the bundled KB-Whisper",
        "Uplink sends event metadata, OGG audio and a 30 s heartbeat over HTTPS with a node token; never transcriptions",
        "Only outbound HTTPS; queued locally for up to 72 h when offline"
      ]
    },
    {
      "dot": "cyan",
      "title": "Aggregator",
      "items": [
        "Only /api/v1/ingest/* is public; nginx answers 404 to everything else",
        "Transcribes uploaded audio centrally with ElevenLabs Scribe; local KB-Whisper (strict) takes over on API errors or without a key; one MQTT alert per event",
        "Web UI, read API and node admin stay on the LAN (no login)"
      ]
    }
  ]
