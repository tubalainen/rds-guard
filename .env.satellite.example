# =============================================================================
#  RDS Guard satellite on its own (docker-compose.satellite.yml)
#  Copy this file to .env and edit. The radio is not set here: see
#  rds-data/receivers.yml, which the satellite writes on its first start.
# =============================================================================

# --- The aggregator ---
# Its address, from the aggregator's owner (your own on the LAN:
# http://<its IP>:8081)
# e.g. https://rds.example.com
AGGREGATOR_URL=
# Only for your own aggregator: the same JOIN_KEY as there approves the
# satellite at once. Without it the aggregator's owner approves it in
# Admin -> Noder (the code is in docker compose logs rds-guard).
JOIN_KEY=
# UPLINK_TOKEN=                # Only if the aggregator's owner gave you one

# --- This satellite ---
# Shown on the aggregator, e.g. Kalle, Karlstad
NODE_NAME=
# Where the receiver is, as "Ort, Län", e.g. Karlstad, Värmlands län: a
# suggestion, the aggregator's Admin -> Noder has the last word. Places the
# traffic messages on the map.
NODE_LOCATION=

# --- Radio ---
# Not here: rds-data/receivers.yml. On its first start the satellite writes
# it with the connected dongles commented out: remove the # and set the
# frequencies (see receivers.example.yml).

# --- Recording (optional) ---
# RECORD_EVENT_TYPES=traffic,emergency  # Event types to record
# MAX_RECORDING_SEC=600        # Safety cutoff (at most 1200)
# SATELLITE_KEEP_DAYS=7        # Keep delivered recordings this long

# --- Uplink (optional) ---
# UPLINK_HEARTBEAT_SEC=10      # Seconds between status reports (at least 10)
# UPLINK_MAX_AGE_HOURS=168     # Drop unsent items older than this
