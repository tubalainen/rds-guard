# =============================================================================
#  RDS Guard aggregator — Configuration
#  Copy this file to .env (next to docker-compose.yml) and edit.
# =============================================================================

# --- Public address ---
# The HTTPS address satellites use: the hostname your reverse proxy (or
# Cloudflare Tunnel) forwards to the ingest port. Only used for the setup
# lines shown when you add a node.
PUBLIC_URL=https://rds.example.com
# Address of the web UI on your LAN. Optional: push messages link to the event.
# WEB_UI_URL=http://192.168.1.5:8080
# NOTIFY_TIMEZONE=Europe/Stockholm  # Time zone for the days/times in push rules
# Password for the Admin page (push rules under Admin → Aviseringar).
# Empty = the Admin page is switched off and the rules cannot be changed.
ADMIN_PASSWORD=

# --- Ports on this host ---
# WEB_UI_BIND=0.0.0.0          # Web UI address; use 127.0.0.1 on a public server
# WEB_UI_PORT=8080             # Web UI port (LAN only, no login)
# INGEST_API_BIND=0.0.0.0      # Ingest API address: where your reverse proxy reaches it
# INGEST_API_PORT=8081         # Ingest API port: the one your reverse proxy forwards to

# --- Storage (the ./aggregator-data folder next to docker-compose.yml) ---
EVENT_RETENTION_DAYS=90        # Delete events and audio older than this
# PUID=10001                   # Owner of the files in ./aggregator-data; the
# PGID=10001                   # server runs as this user. E.g. your own: id -u / id -g

# --- Transcription of uploaded audio ---
# "local"  = built-in faster-whisper on CPU
# "remote" = external Whisper ASR server via HTTP
# "elevenlabs" = ElevenLabs Scribe cloud API with local fallback (default;
#                without ELEVENLABS_API_KEY it transcribes locally)
# "none"   = no transcription (audio is still stored and playable)
TRANSCRIPTION_ENGINE=elevenlabs
TRANSCRIPTION_LANGUAGE=sv
TRANSCRIPTION_MODEL=            # empty = bundled KB-Whisper small (strict) for sv; or tiny…large-v3, KBLab/kb-whisper-medium (local only)
#TRANSCRIPTION_PROMPT=Trafikverket, E4, E18, olycka, kö, körfält
TRANSCRIPTION_DEVICE=cpu       # cpu or cuda (local only)
# WHISPER_REMOTE_URL=http://whisper:9000
# WHISPER_REMOTE_TIMEOUT=120

# ElevenLabs Scribe (TRANSCRIPTION_ENGINE=elevenlabs, the default).
# Cloud API, ~USD 0.20-0.24 per hour of audio (2-3 öre per message); on API errors the clip is
# transcribed locally instead (TRANSCRIPTION_FALLBACK=local).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=scribe_v3      # scribe_v3 (numbers as digits) or scribe_v2
# ELEVENLABS_KEYTERMS=E18, Karlstad, Bergviksmotet, Våxnäsmotet, Klaramotet
# ELEVENLABS_TIMEOUT=60
# TRANSCRIPTION_FALLBACK=local    # local or none

# --- MQTT (optional) ---
MQTT_ENABLED=false
# MQTT_HOST=192.168.1.100
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=rds-aggregator  # Different from the satellites' "rds" on purpose
MQTT_CLIENT_ID=rds-guard-aggregator

# --- Alert timing ---
# ALERT_AUDIO_WAIT_SEC=90            # Wait for audio after an event ended
# ALERT_TRANSCRIPTION_WAIT_SEC=300   # Wait for the transcription after audio arrived
# ALERT_MAX_DELAY_MIN=60             # Don't alert events that ended longer ago

# --- Satellites ---
# NODE_OFFLINE_SEC=120         # Node counts as offline after this long without heartbeat
# INGEST_RATE_PER_MIN=120      # Requests per minute per node
# INGEST_BURST=60
