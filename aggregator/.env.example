# =============================================================================
#  RDS Guard aggregator — Configuration
#  Copy this file to .env (next to docker-compose.yml) and edit.
# =============================================================================

# --- Public address ---
# The HTTPS address satellites use, e.g. your Cloudflare hostname. Only used
# for the setup lines shown when you add a node.
PUBLIC_URL=https://rds.example.com

# --- Cloudflare Tunnel (only with: docker compose --profile tunnel up -d) ---
# CLOUDFLARE_TUNNEL_TOKEN=     # From Zero Trust → Networks → Tunnels

# --- Ports on this host ---
# WEB_UI_BIND=0.0.0.0          # Web UI address; use 127.0.0.1 on a public server
# WEB_UI_PORT=8080             # Web UI port (LAN only, no login)
# NGINX_BIND=127.0.0.1         # nginx address (not needed with the tunnel)
# NGINX_PORT=8088              # nginx port

# --- Storage ---
EVENT_RETENTION_DAYS=90        # Delete events and audio older than this

# --- Transcription of uploaded audio ---
# "local"  = built-in faster-whisper on CPU
# "remote" = external Whisper ASR server via HTTP
# "none"   = no transcription (audio is still stored and playable)
TRANSCRIPTION_ENGINE=local
TRANSCRIPTION_LANGUAGE=sv
TRANSCRIPTION_MODEL=            # empty = KBLab/kb-whisper-small for sv; or tiny…large-v3, KBLab/kb-whisper-medium (local only)
#TRANSCRIPTION_PROMPT=Trafikverket, E4, E18, olycka, kö, körfält
TRANSCRIPTION_DEVICE=cpu       # cpu or cuda (local only)
# WHISPER_REMOTE_URL=http://whisper:9000
# WHISPER_REMOTE_TIMEOUT=120

# --- MQTT (optional) ---
MQTT_ENABLED=false
# MQTT_HOST=192.168.1.100
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=rds-aggregator  # Different from the satellites' "rds" on purpose
MQTT_CLIENT_ID=rds-guard-aggregator

# --- Alert timing ---
# ALERT_AUDIO_WAIT_SEC=90            # Wait for audio after an event ended
# ALERT_TRANSCRIPTION_WAIT_SEC=300   # Wait for the transcription after audio arrived
# ALERT_MAX_DELAY_MIN=60             # Don't alert events that ended longer ago

# --- Satellites ---
# NODE_OFFLINE_SEC=120         # Node counts as offline after this long without heartbeat
# INGEST_RATE_PER_MIN=120      # Requests per minute per node
# INGEST_BURST=60
